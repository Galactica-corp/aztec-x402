{
  "name": "@galactica-net/aztec-x402",
  "private": true,
  "version": "1.1.0",
  "description": "x402 HTTP 402 payment protocol for Aztec private stablecoins",
  "author": "Galactica Network",
  "license": "Apache-2.0",
  "homepage": "https://overcast.fi/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Galactica-corp/aztec-x402.git"
  },
  "bugs": {
    "url": "https://github.com/Galactica-corp/aztec-x402/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --filter '*' build",
    "test": "bun run --filter '*' test",
    "lint": "oxlint --config .oxlintrc.json packages/",
    "clean": "bun run --filter '*' clean",
    "setup": "NODE_URL=https://v5.testnet.rpc.aztec-labs.com AZTEC_NETWORK=aztec:testnet USE_SPONSORED_FPC=true bun run ./packages/demo/src/aztec/setup.ts",
    "server": "USE_SPONSORED_FPC=true bun run ./packages/demo/src/aztec/real-server.ts",
    "setup:sandbox": "NODE_URL=http://localhost:8080 AZTEC_NETWORK=aztec:sandbox USE_SPONSORED_FPC=true bun run ./packages/demo/src/aztec/setup.ts",
    "demo": "bun run ./packages/demo/src/aztec/real-client.ts",
    "demo:sandbox": "SERVER_URL=http://localhost:4402 USE_SPONSORED_FPC=true bun run ./packages/demo/src/aztec/real-client.ts",
    "server:sandbox": "USE_SPONSORED_FPC=true bun run ./packages/demo/src/aztec/real-server.ts",
    "demo:replay": "bun run ./packages/demo/src/aztec/replay-test.ts"
  },
  "devDependencies": {
    "@types/node": "^25.4.0",
    "oxlint": "^1.52.0",
    "tsup": "^8.5.1"
  }
}
