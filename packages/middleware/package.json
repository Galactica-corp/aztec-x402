{
  "name": "@galactica-net/middleware",
  "version": "1.0.0",
  "description": "Express middleware for x402 payment gating on Aztec",
  "author": "Galactica Network",
  "license": "Apache-2.0",
  "homepage": "https://overcast.fi/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Galactica-corp/aztec-x402.git",
    "directory": "packages/middleware"
  },
  "bugs": {
    "url": "https://github.com/Galactica-corp/aztec-x402/issues"
  },
  "keywords": [
    "aztec",
    "x402",
    "payments",
    "micropayments",
    "privacy",
    "stablecoin",
    "express",
    "middleware"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src/index.ts",
    "src/middleware.ts",
    "src/types.ts"
  ],
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "bun test",
    "clean": "rm -rf dist",
    "prepublishOnly": "bun run build"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "dependencies": {
    "@galactica-net/core": "workspace:*",
    "@galactica-net/mechanism": "workspace:*",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@types/uuid": "^11.0.0",
    "typescript": "^5.5.0",
    "zod": "^4.4.3"
  }
